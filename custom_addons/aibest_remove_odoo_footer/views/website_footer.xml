<odoo>
    <template id="remove_odoo_footer_inherit" inherit_id="website.layout">
        <xpath expr="//div[contains(@class, 'o_footer_copyright')]" position="replace">
            <div class="o_footer_copyright o_colored_level o_cc" data-name="Copyright">
                <div class="container py-3">
                    <div class="row">
                        <!-- 左侧：公司名称 -->
                        <div class="col-sm text-center text-sm-start text-muted">
                            <span class="o_footer_copyright_name me-2">
                                版权所有 © <t t-esc="time.strftime('%Y')"/> 东莞市博思拓实业有限公司
                            </span>
                        </div>
                        <!-- 右侧：备案信息 -->
                        <div class="col-sm text-center text-sm-end text-muted">
                            <span class="me-2">
                                <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">
                                    粤ICP备12345678号
                                </a>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
